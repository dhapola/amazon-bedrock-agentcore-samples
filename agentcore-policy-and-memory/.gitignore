# Local environment (loaded by `agentcore dev`; never commit secrets)
.env.local
.env*.local

# Python
__pycache__/
*.py[cod]
.venv/

# Node
node_modules/

# AgentCore CLI state (ignore local scratch like traces/logs, but commit the
# deployed-state binding so a target's stack + credential ARNs are shared)
agentcore/.cli/*
!agentcore/.cli/deployed-state.json

# AgentCore CLI build staging (vendored packages copied for the CodeZip)
agentcore/.cache/

# macOS
.DS_Store

# CDK
agentcore/cdk/cdk.out/

# Generated from aws-targets.template.json by agentcore/write-aws-targets.sh (holds the account ID)
agentcore/aws-targets.json
